{
  // 全アプリを1つの Worker (静的アセット) で配信する。
  // name はリポジトリ名と同じにしてあるので、Cloudflare の画面でプロジェクト名を変える必要はない。
  "name": "claude-workspace",
  "compatibility_date": "2026-10-01",
  "assets": {
    // scripts/build.mjs が作る dist/ をそのまま配信する (リポジトリにコミット済み)
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // 公開URLは https://apps.karin-lab.com/<アプリ名>/
  "routes": [
    { "pattern": "apps.karin-lab.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
