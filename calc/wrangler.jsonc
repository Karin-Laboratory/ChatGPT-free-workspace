{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calc-claude",
  "compatibility_date": "2026-10-01",
  // Vite のビルド成果物 (dist) を静的アセットとして配信する
  "assets": {
    "directory": "./dist"
  },
  // karin-lab.com ゾーンが同じ Cloudflare アカウントにあること
  "routes": [
    { "pattern": "calc-claude.karin-lab.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
