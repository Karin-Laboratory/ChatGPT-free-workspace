{
  // Worker 名とドメインは scripts/validate-app.sh が "<フォルダ名>-claude" であることを検査する
  "name": "__APP__-claude",
  "compatibility_date": "2026-10-01",
  // 静的アセットだけの Worker (無料枠で配信)。ビルドが必要なら ./dist などに変えてよい
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "__APP__-claude.karin-lab.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
